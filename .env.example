# Copy to .env. Never commit .env.
#
# Two groups. The first works today with no account anywhere and is what all
# seven tracks use for local development. The second is unset until the repo
# owner supplies credentials, and only B2's recording session and B5's deploy
# need it.

# ---------------------------------------------------------------------------
# Local. Works out of the box.
# ---------------------------------------------------------------------------

# Port 5433, not 5432. docker-compose.yml maps it that way because another
# project's Postgres commonly holds 5432 and compose then fails to start at all.
DATABASE_URL=postgresql://brandpulse:brandpulse@localhost:5433/brandpulse

# replay reads fixtures/ and makes zero network calls. This is the default
# everywhere including CI. A test that needs anything else is a broken test.
# record and live spend real credits and are B2's alone.
BP_FIXTURE_MODE=replay

# ---------------------------------------------------------------------------
# Live. Unset until the repo owner supplies them. See "Open blockers".
# ---------------------------------------------------------------------------

# 300 free credits, total, for the whole project. Spent once, by B2, with a
# dry-run estimate printed first. Sent as `X-API-Key: <key>`, not as a Bearer
# token. Key shape is `ask_` + 64 hex.
ANAKIN_API_KEY=

# DronaHQ, for the chat agent and the ops dashboard. B5 is the only track
# that needs it. Key shape is `sk_` + 32 chars.
DRONAHQ_API_KEY=

# Nasiko injects all three of these into a deployed container. Set them locally
# only to run an agent outside Nasiko. No agent reads them directly; internal/llm
# is the only caller.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# The model name sent in the request body, read by internal/llm/llm.go. It wins
# over the per-agent Opt.Model. The Nasiko router ignores the body and resolves
# the model from `nasiko llm-config`, so leave it empty when deployed. Pointing
# OPENAI_BASE_URL straight at a provider needs a real model name here, because
# a Nasiko alias like "bp-briefer-default" names a router entry, not a model.
OPENAI_MODEL=

# Nasiko injects this too. internal/obs is a no-op when it is empty, so an
# agent run locally is silent rather than broken.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Where one agent finds another, read by internal/a2a/call.go. It is a template,
# not a base URL: the literal {agent} is substituted with the peer's name, so a
# value without {agent} is refused rather than resolving every peer to one
# address. The name is ours, not Nasiko's. Two shapes are in use:
#
#   compose:  http://{agent}:8000/
#   deployed: https://<control-plane-host>/api/agents/{agent}
#
# docker-compose.agents.yml sets the compose shape itself, so this matters when
# an agent is run outside compose.
NASIKO_API_URL=http://{agent}:8000/

# Nasiko injects this. 8000 is the local default.
PORT=8000

# The Nasiko router resolves the model server-side via `nasiko llm-config`, so
# these are local-run defaults only and do nothing once deployed.
BP_MODEL_SMALL=
BP_MODEL_EMBED=

# ---------------------------------------------------------------------------
# bff/. The dashboard's only backend. Read once at startup by bff/src/env.ts,
# which refuses to boot when a required one is missing.
# ---------------------------------------------------------------------------

# The one browser origin CORS permits. Never a list, never "*". Required.
DASHBOARD_ORIGIN=http://localhost:3000

# bp-orchestrator's A2A base URL, the only agent address the BFF knows.
# Required. Injected at deploy time; this is the local orchestrator.
ORCHESTRATOR_URL=http://127.0.0.1:8000/

# The BFF reads the same PORT as an agent does and defaults to 8080 when it is
# unset. This file sets PORT=8000 for the agents above, so pass PORT=8080 on the
# BFF's own command line rather than relying on the value here.
# HOST defaults to 0.0.0.0; 127.0.0.1 keeps it off the network.
HOST=127.0.0.1

# Ceilings, both optional, milliseconds, positive integers. Shown at their
# defaults. A run fans out nine agents behind one call, hence the generous
# orchestrator ceiling; without it a hung agent hangs the dashboard.
ORCHESTRATOR_TIMEOUT_MS=120000
DATABASE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# web/. The Next.js dashboard. These two are the only variables it reads.
# ---------------------------------------------------------------------------

# Where the BFF listens. Server-side only: no NEXT_PUBLIC_ prefix, so it never
# reaches the browser bundle. No page renders without it.
BFF_BASE_URL=http://localhost:8080

# Which brand this deployment shows. One brand per deployment. A missing value
# throws rather than defaulting to a name. brd_demo is the seeded demo brand.
BRAND_ID=brd_demo
