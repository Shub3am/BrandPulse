{
  "openapi": "3.0.3",
  "info": {
    "title": "BrandPulse BFF",
    "version": "1.0.0",
    "description": "The BrandPulse backend-for-frontend. Seven routes plus a health check, read out of Postgres or forwarded from the agent mesh. No authentication. Two write routes, POST /api/runs and POST /api/brands, and both spend Anakin credits and LLM tokens. There is no approve, acknowledge, snooze or send route, and nothing in this API publishes anything anywhere.\n\nEVERY operation sends the header ngrok-skip-browser-warning with the value 1. Free ngrok answers browser-like clients with an HTML interstitial page unless that header is present, and DronaHQ would then receive HTML where it expects JSON. Do not remove it from any endpoint."
  },
  "servers": [
    {
      "url": "https://unknowing-tubby-thrive.ngrok-free.dev",
      "description": "Public ngrok tunnel in front of the running BFF. This host changes every time the tunnel restarts. When it changes, re-import this file after updating servers.url here, or edit the URL field on each endpoint in the DronaHQ connector."
    }
  ],
  "tags": [
    { "name": "Brands", "description": "The brand roster and brand creation." },
    { "name": "Pulse", "description": "Everything the dashboard's first paint reads, in one call." },
    { "name": "Mentions", "description": "The enriched mention stream." },
    { "name": "Alerts", "description": "The alert feed." },
    { "name": "Runs", "description": "Collection runs." },
    { "name": "Health", "description": "Liveness." }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Cheap liveness probe. Does not touch Postgres. Use this as the first connector test, because it proves the tunnel, the header and the base URL in one call.",
        "parameters": [{ "$ref": "#/components/parameters/NgrokSkipBrowserWarning" }],
        "responses": {
          "200": {
            "description": "The BFF is up.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/api/brands": {
      "get": {
        "tags": ["Brands"],
        "operationId": "listBrands",
        "summary": "List brands",
        "description": "Every brand in the account, ordered by name, unpaginated. Note the field name: this route returns the BFF's own picker shape and calls the identifier id, where every other response in this API calls it brand_id. A dropdown bound to brand_id renders a list of blanks.",
        "parameters": [{ "$ref": "#/components/parameters/NgrokSkipBrowserWarning" }],
        "responses": {
          "200": {
            "description": "The brand roster.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/BrandSummary" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Brands"],
        "operationId": "createBrand",
        "summary": "Create a brand",
        "description": "Creates a brand and a first confirmed profile. Spends Anakin credits and LLM tokens: the route asks bp-onboarder to crawl the website and draft keywords. Returns 201, not 200, so a DronaHQ success condition written as statusCode == 200 treats every created brand as a failure. The returned brand_id is a slug of the name plus a random four-character tail and cannot be constructed client-side. When onboarder_error is present the brand was still created, from the typed keywords alone.",
        "parameters": [{ "$ref": "#/components/parameters/NgrokSkipBrowserWarning" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBrandRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The brand was created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreatedBrand" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/brands/{id}/pulse": {
      "get": {
        "tags": ["Pulse"],
        "operationId": "getBrandPulse",
        "summary": "Get brand pulse",
        "description": "The brand's whole current picture in one call: profile, latest run, daily brief, alerts, topics, recent mentions and reply drafts. Seven independent queries, and a query that fails names itself in errors rather than failing the request, so a partial answer is still a 200.\n\nTwo slots are always empty by design. share_of_voice is always null, because no agent output for that type is persisted; the figure to render is brief.numbers.share_of_voice. topics[].top_examples is always an empty array.\n\nThe limit parameter moves the mention slice only. The alert, topic and draft slices are fixed at 20, 12 and 20.",
        "parameters": [
          { "$ref": "#/components/parameters/NgrokSkipBrowserWarning" },
          { "$ref": "#/components/parameters/BrandIdPath" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many mentions to include. Defaults to 50, capped silently at 200.",
            "schema": { "type": "integer", "minimum": 1, "default": 50, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "The brand's current pulse.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pulse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/brands/{id}/mentions": {
      "get": {
        "tags": ["Mentions"],
        "operationId": "getMentions",
        "summary": "List enriched mentions",
        "description": "The mention stream, newest first. Each element is two levels deep: a mention object and an enrichment object. A DronaHQ Table Grid wants a flat array, so flatten with a JavaScript transformation on the query, for example mention.text and enrichment.sentiment_label.",
        "parameters": [
          { "$ref": "#/components/parameters/NgrokSkipBrowserWarning" },
          { "$ref": "#/components/parameters/BrandIdPath" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many mentions to return. Defaults to 50, capped silently at 200.",
            "schema": { "type": "integer", "minimum": 1, "default": 50, "maximum": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Enriched mentions, newest first. An empty array means the brand has no enriched mentions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/EnrichedMention" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/brands/{id}/alerts": {
      "get": {
        "tags": ["Alerts"],
        "operationId": "getAlerts",
        "summary": "List alerts",
        "description": "The alert feed, newest first. There is no LLM behind an alert, so the evidence array is the entire reason it fired: metric, value, threshold and window. Quote those four rather than saying an AI detected a pattern.",
        "parameters": [
          { "$ref": "#/components/parameters/NgrokSkipBrowserWarning" },
          { "$ref": "#/components/parameters/BrandIdPath" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "How many alerts to return. Defaults to 20, capped silently at 100.",
            "schema": { "type": "integer", "minimum": 1, "default": 20, "maximum": 100 }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Exclusive lower bound on created_at, RFC 3339. Pass back a created_at this route returned earlier, never a browser clock reading: a clock running fast against the database skips an alert.",
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Alerts, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Alert" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/runs": {
      "post": {
        "tags": ["Runs"],
        "operationId": "startRun",
        "summary": "Start a collection run",
        "description": "Asks bp-orchestrator to collect and enrich. Spends Anakin credits and LLM tokens, so bind this to a button a human presses, never to an auto-running query. Returns the RunRecord the orchestrator produced, forwarded unchanged. A run that comes back with status partial and a populated errors array is a real run that got through some of its sources, and is a 200.\n\nwindow_hours and force are optional and must be omitted rather than sent empty: window_hours 0 is a window of zero hours and the BFF rejects it with a 400.",
        "parameters": [{ "$ref": "#/components/parameters/NgrokSkipBrowserWarning" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StartRunRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The run record.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunRecord" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/runs/{id}": {
      "get": {
        "tags": ["Runs"],
        "operationId": "getRun",
        "summary": "Get a run by id",
        "description": "One run record by its id. Poll this after startRun to watch status move from running to ok, partial or failed.",
        "parameters": [
          { "$ref": "#/components/parameters/NgrokSkipBrowserWarning" },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The run id, as returned by startRun. Bind the DronaHQ variable runid here. DronaHQ variable names must not contain an underscore, so runid and never run_id.",
            "schema": { "type": "string" },
            "example": "run_01M2ZC44KQVMW5M2GC816KHWBW"
          }
        ],
        "responses": {
          "200": {
            "description": "The run record.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunRecord" }
              }
            }
          },
          "404": {
            "description": "No run with that id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "NgrokSkipBrowserWarning": {
        "name": "ngrok-skip-browser-warning",
        "in": "header",
        "required": true,
        "description": "Must be sent on every request. Free ngrok returns an HTML interstitial page to browser-like clients unless this header is present, and DronaHQ would parse that HTML as a failed JSON response.",
        "schema": { "type": "string", "default": "1" },
        "example": "1"
      },
      "BrandIdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The brand id, as returned in the id field of listBrands. The demo brand is brd_demo.",
        "schema": { "type": "string" },
        "example": "brd_demo"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request was malformed. The message names the offending field.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Every error the BFF returns has this one shape.",
        "properties": {
          "error": { "type": "string", "example": "brand_id is required and must be a non-empty string" }
        },
        "required": ["error"]
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        },
        "required": ["ok"]
      },
      "Source": {
        "type": "string",
        "description": "A collection source.",
        "enum": ["x", "reddit", "youtube", "news", "playstore", "appstore", "amazon", "flipkart", "instagram", "web"]
      },
      "Channel": {
        "type": "string",
        "description": "A Source value, or one of the three reply-only channels.",
        "enum": ["x", "reddit", "youtube", "news", "playstore", "appstore", "amazon", "flipkart", "instagram", "web", "whatsapp", "email", "statement"]
      },
      "SentimentLabel": {
        "type": "string",
        "enum": ["negative", "neutral", "positive", "mixed"]
      },
      "Emotion": {
        "type": "string",
        "enum": ["anger", "joy", "sadness", "fear", "disgust", "surprise", "neutral"]
      },
      "Intent": {
        "type": "string",
        "enum": ["complaint", "praise", "question", "purchase_intent", "comparison", "spam", "news", "other"]
      },
      "RunKind": {
        "type": "string",
        "enum": ["onboard", "scheduled", "on_demand", "crisis_replay"]
      },
      "RunStatus": {
        "type": "string",
        "enum": ["running", "ok", "partial", "failed"]
      },
      "AlertKind": {
        "type": "string",
        "enum": ["spike", "crisis", "influencer_mention", "competitor_move", "review_bomb"]
      },
      "Severity": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"]
      },
      "AlertStatus": {
        "type": "string",
        "enum": ["open", "acked", "snoozed", "resolved"]
      },
      "DraftStatus": {
        "type": "string",
        "enum": ["draft", "approved", "rejected", "sent"]
      },
      "BrandSummary": {
        "type": "object",
        "description": "The brand picker's shape. Three fields, and the identifier is id, not brand_id.",
        "properties": {
          "id": { "type": "string", "example": "brd_demo" },
          "name": { "type": "string", "example": "Suncoast" },
          "website": {
            "type": "string",
            "description": "Absent, not null, when the brand has no website on record.",
            "example": "https://suncoast.example.in"
          }
        },
        "required": ["id", "name"]
      },
      "BrandVoice": {
        "type": "object",
        "properties": {
          "tone": { "type": "string", "example": "warm, direct, no corporate filler" },
          "language": { "type": "string", "example": "English with light Hinglish if the mention is Hinglish" },
          "signature": { "type": "string", "example": "- Team Suncoast" },
          "do_not_say": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["tone", "language", "do_not_say"]
      },
      "BrandProfile": {
        "type": "object",
        "properties": {
          "brand_id": { "type": "string", "example": "brd_demo" },
          "name": { "type": "string", "example": "Suncoast" },
          "website": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "hashtags": { "type": "array", "items": { "type": "string" } },
          "products": { "type": "array", "items": { "type": "string" } },
          "competitors": { "type": "array", "items": { "type": "string" } },
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } },
          "negative_keywords": { "type": "array", "items": { "type": "string" } },
          "source_handles": {
            "type": "object",
            "description": "Source name to the brand's handle or listing id on that source.",
            "additionalProperties": { "type": "string" }
          },
          "voice": { "$ref": "#/components/schemas/BrandVoice" },
          "version": { "type": "integer", "example": 1 }
        },
        "required": ["brand_id", "name", "keywords", "hashtags", "products", "competitors", "sources", "negative_keywords", "source_handles", "voice", "version"]
      },
      "Engagement": {
        "type": "object",
        "description": "Forwarded exactly as stored. A mention written without engagement carries an object with no counts, not four zeros.",
        "properties": {
          "likes": { "type": "integer" },
          "replies": { "type": "integer" },
          "shares": { "type": "integer" },
          "views": { "type": "integer" }
        }
      },
      "Mention": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "brand_id": { "type": "string" },
          "source": { "$ref": "#/components/schemas/Source" },
          "external_id": { "type": "string" },
          "url": { "type": "string" },
          "author": { "type": "string" },
          "author_followers": { "type": "integer" },
          "text": { "type": "string" },
          "lang": { "type": "string" },
          "posted_at": { "type": "string", "format": "date-time" },
          "engagement": { "$ref": "#/components/schemas/Engagement" },
          "rating": { "type": "number" },
          "matched_keyword": { "type": "string" },
          "content_hash": { "type": "string" },
          "raw": { "type": "object", "additionalProperties": true }
        },
        "required": ["id", "brand_id", "source", "external_id", "author_followers", "text", "lang", "posted_at", "engagement", "content_hash"]
      },
      "Enrichment": {
        "type": "object",
        "properties": {
          "mention_id": { "type": "string" },
          "sentiment": { "type": "number", "description": "Signed score. Negative is negative sentiment." },
          "sentiment_label": { "$ref": "#/components/schemas/SentimentLabel" },
          "emotion": { "$ref": "#/components/schemas/Emotion" },
          "intent": { "$ref": "#/components/schemas/Intent" },
          "aspects": { "type": "array", "items": { "type": "string" } },
          "is_about_brand": { "type": "boolean" },
          "about_competitor": { "type": "string" },
          "model": { "type": "string" },
          "cost_paise": { "type": "number", "description": "Paise, fractional. A float on the wire, not an integer." }
        },
        "required": ["mention_id", "sentiment", "sentiment_label", "emotion", "intent", "aspects", "is_about_brand", "model", "cost_paise"]
      },
      "EnrichedMention": {
        "type": "object",
        "description": "Two levels deep. Flatten before binding to a Table Grid.",
        "properties": {
          "mention": { "$ref": "#/components/schemas/Mention" },
          "enrichment": { "$ref": "#/components/schemas/Enrichment" }
        },
        "required": ["mention", "enrichment"]
      },
      "AlertEvidence": {
        "type": "object",
        "description": "One statistical fact that fired an alert. Forwarded verbatim, never summarised.",
        "properties": {
          "metric": { "type": "string", "example": "volume_zscore" },
          "value": { "type": "number", "example": 66.9 },
          "threshold": { "type": "number", "example": 3 },
          "window": { "type": "string", "example": "1h" },
          "detail": { "type": "string", "example": "13 mentions against a mean of 0.0, std 0.2, over 14 days" }
        },
        "required": ["metric", "value", "threshold", "window"]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "brand_id": { "type": "string" },
          "kind": { "$ref": "#/components/schemas/AlertKind" },
          "severity": { "$ref": "#/components/schemas/Severity" },
          "title": { "type": "string", "example": "Negative surge on reddit" },
          "why": { "type": "string" },
          "evidence": {
            "type": "array",
            "description": "The entire reason the alert fired. There is no LLM behind it.",
            "items": { "$ref": "#/components/schemas/AlertEvidence" }
          },
          "sample_mentions": {
            "type": "array",
            "description": "Whole mentions, resolved from stored ids. An id with no surviving mention is dropped rather than stood in for.",
            "items": { "$ref": "#/components/schemas/Mention" }
          },
          "status": { "$ref": "#/components/schemas/AlertStatus" },
          "dedupe_key": { "type": "string" },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Pass this value back as the since parameter to poll for newer alerts."
          }
        },
        "required": ["id", "brand_id", "kind", "severity", "title", "why", "evidence", "sample_mentions", "status", "dedupe_key", "created_at"]
      },
      "ReplyDraft": {
        "type": "object",
        "description": "A suggested reply. Nothing in this system posts it. There is no send route and no approve route.",
        "properties": {
          "id": { "type": "string" },
          "alert_id": { "type": "string" },
          "mention_id": { "type": "string" },
          "channel": { "$ref": "#/components/schemas/Channel" },
          "text": { "type": "string" },
          "tone": { "type": "string" },
          "do_not_say": { "type": "array", "items": { "type": "string" } },
          "status": { "$ref": "#/components/schemas/DraftStatus" },
          "requires_human_approval": {
            "type": "boolean",
            "description": "Always true. It is emitted unconditionally and there is no column behind it.",
            "example": true
          }
        },
        "required": ["id", "channel", "text", "tone", "do_not_say", "status", "requires_human_approval"]
      },
      "Topic": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "brand_id": { "type": "string" },
          "window_start": { "type": "string", "format": "date-time" },
          "window_end": { "type": "string", "format": "date-time" },
          "label": { "type": "string", "example": "refund delays" },
          "summary": { "type": "string" },
          "size": { "type": "integer", "description": "How many mentions fell into this topic.", "example": 4 },
          "sentiment_mix": {
            "type": "object",
            "description": "Sentiment label to its count or share within the topic. Keys are a subset of the SentimentLabel values.",
            "additionalProperties": { "type": "number" }
          },
          "top_examples": {
            "type": "array",
            "description": "Always an empty array. The clusterer's choice of examples has no column, so the BFF does not invent one.",
            "items": { "$ref": "#/components/schemas/Mention" }
          },
          "trend": { "type": "number" },
          "mention_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "brand_id", "window_start", "window_end", "label", "summary", "size", "sentiment_mix", "top_examples", "trend", "mention_ids"]
      },
      "ShareOfVoice": {
        "type": "object",
        "description": "Declared because the contract declares it. The pulse always returns null here; render brief.numbers.share_of_voice instead.",
        "properties": {
          "brand_id": { "type": "string" },
          "window_start": { "type": "string", "format": "date-time" },
          "window_end": { "type": "string", "format": "date-time" },
          "brand_share": { "type": "number" },
          "competitor_shares": { "type": "object", "additionalProperties": { "type": "number" } },
          "by_source": {
            "type": "object",
            "additionalProperties": { "type": "object", "additionalProperties": { "type": "number" } }
          },
          "total_mentions": { "type": "integer" }
        },
        "required": ["brand_id", "window_start", "window_end", "brand_share", "competitor_shares", "by_source", "total_mentions"]
      },
      "BriefNumbers": {
        "type": "object",
        "properties": {
          "mentions": { "type": "integer", "example": 57 },
          "mentions_delta_pct": { "type": "number", "example": 0 },
          "sentiment_avg": { "type": "number", "example": 0.0175 },
          "negative_share": { "type": "number", "example": 3.51 },
          "share_of_voice": {
            "type": "number",
            "description": "The only share of voice figure this API serves. Pulse.share_of_voice is always null.",
            "example": 100
          }
        },
        "required": ["mentions", "mentions_delta_pct", "sentiment_avg", "negative_share", "share_of_voice"]
      },
      "DailyBrief": {
        "type": "object",
        "properties": {
          "brand_id": { "type": "string" },
          "period_start": { "type": "string", "format": "date-time" },
          "period_end": { "type": "string", "format": "date-time" },
          "headline": { "type": "string", "example": "Brand mentions were quiet, with negative sentiment on Reddit concerns." },
          "numbers": { "$ref": "#/components/schemas/BriefNumbers" },
          "top_topics": { "type": "array", "items": { "$ref": "#/components/schemas/Topic" } },
          "alerts": { "type": "array", "items": { "$ref": "#/components/schemas/Alert" } },
          "competitor_watch": {
            "type": "array",
            "nullable": true,
            "description": "Null, not an empty array, when the briefer named no competitor. Verified against the live API.",
            "items": { "type": "string" }
          },
          "suggested_actions": { "type": "array", "items": { "type": "string" } },
          "markdown": { "type": "string" },
          "whatsapp_short": { "type": "string" }
        },
        "required": ["brand_id", "period_start", "period_end", "headline", "numbers", "top_topics", "alerts", "suggested_actions", "markdown", "whatsapp_short"]
      },
      "RunRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "run_01M2ZC44KQVMW5M2GC816KHWBW" },
          "brand_id": { "type": "string", "example": "brd_demo" },
          "kind": { "$ref": "#/components/schemas/RunKind" },
          "time_bucket": { "type": "string", "example": "2026-09-20" },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time", "description": "Absent while the run is still going." },
          "status": { "$ref": "#/components/schemas/RunStatus" },
          "credits_used": { "type": "integer" },
          "tokens_used": { "type": "integer" },
          "cost_paise": { "type": "number", "description": "Paise, fractional. A float on the wire, not an integer." },
          "sources_attempted": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } },
          "sources_skipped": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } },
          "degraded_reason": { "type": "string", "description": "Present when the orchestrator dropped sources, with the reason it dropped them." },
          "mentions_collected": { "type": "integer" },
          "errors": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "brand_id", "kind", "time_bucket", "started_at", "status", "credits_used", "tokens_used", "cost_paise", "sources_attempted", "sources_skipped", "mentions_collected", "errors"]
      },
      "Pulse": {
        "type": "object",
        "description": "One call, seven slots. A slot whose query failed holds its empty value and names itself in errors.",
        "properties": {
          "brand_id": { "type": "string", "example": "brd_demo" },
          "profile": {
            "allOf": [{ "$ref": "#/components/schemas/BrandProfile" }],
            "nullable": true
          },
          "run": {
            "allOf": [{ "$ref": "#/components/schemas/RunRecord" }],
            "nullable": true,
            "description": "The latest run for this brand, or null if it has never run."
          },
          "brief": {
            "allOf": [{ "$ref": "#/components/schemas/DailyBrief" }],
            "nullable": true
          },
          "share_of_voice": {
            "allOf": [{ "$ref": "#/components/schemas/ShareOfVoice" }],
            "nullable": true,
            "description": "Always null. Read brief.numbers.share_of_voice instead."
          },
          "alerts": {
            "type": "array",
            "description": "Newest first, fixed at 20 regardless of limit.",
            "items": { "$ref": "#/components/schemas/Alert" }
          },
          "topics": {
            "type": "array",
            "description": "Fixed at 12 regardless of limit.",
            "items": { "$ref": "#/components/schemas/Topic" }
          },
          "mentions": {
            "type": "array",
            "description": "Newest first. This is the slice the limit parameter moves.",
            "items": { "$ref": "#/components/schemas/EnrichedMention" }
          },
          "drafts": {
            "type": "array",
            "description": "Fixed at 20 regardless of limit.",
            "items": { "$ref": "#/components/schemas/ReplyDraft" }
          },
          "errors": {
            "type": "array",
            "description": "One entry per query that failed. Empty means every slot above is complete.",
            "items": { "type": "string" }
          }
        },
        "required": ["brand_id", "profile", "run", "brief", "share_of_voice", "alerts", "topics", "mentions", "drafts", "errors"]
      },
      "CreateBrandRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Required, non-empty.", "example": "Acme" },
          "website": {
            "type": "string",
            "description": "Required. Must include the scheme and it must be http or https. A bare acme.example is a 400.",
            "example": "https://acme.example"
          },
          "keywords": {
            "type": "array",
            "description": "Optional. Kept alongside whatever the onboarder finds, case-insensitively deduplicated, typed terms first.",
            "items": { "type": "string" }
          },
          "competitors": {
            "type": "array",
            "description": "Optional.",
            "items": { "type": "string" }
          }
        },
        "required": ["name", "website"]
      },
      "CreatedBrand": {
        "type": "object",
        "properties": {
          "brand_id": { "type": "string", "example": "brd_acme_4f2a" },
          "onboarder_error": {
            "type": "string",
            "description": "Present only when bp-onboarder could not be reached or refused the site. The brand was still created, from the typed keywords alone. Show this, or the screen claims an agent enriched a profile that nothing enriched."
          }
        },
        "required": ["brand_id"]
      },
      "StartRunRequest": {
        "type": "object",
        "properties": {
          "brand_id": { "type": "string", "description": "Required, non-empty.", "example": "brd_demo" },
          "trigger": {
            "allOf": [{ "$ref": "#/components/schemas/RunKind" }],
            "description": "Required. Anything outside the four values is a 400 listing them."
          },
          "window_hours": {
            "type": "integer",
            "minimum": 1,
            "description": "Optional. Omit rather than sending 0: a non-positive integer is a 400, and the orchestrator applies its own default when the key is absent."
          },
          "force": { "type": "boolean", "description": "Optional." }
        },
        "required": ["brand_id", "trigger"]
      }
    }
  }
}
